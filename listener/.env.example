# Skopiuj jako .env i uzupełnij lokalnie. Nie commituj pliku .env.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pl
SAMPLE_RATE=16000
AUTO_START_LISTENING=false
# Opcjonalnie: indeks lub nazwa urządzenia zwrócona przez sounddevice.
# MICROPHONE_DEVICE=Microphone Array
VOICELOOP_TOKEN=

VOICELOOP_HOST=127.0.0.1
VOICELOOP_PORT=8765
VOICELOOP_LOG_LEVEL=INFO
VOICELOOP_DATA_DIR=../data

N8N_BASE_URL=http://127.0.0.1:5678
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/voice-command-v1
N8N_TOKEN=
N8N_TIMEOUT_SECONDS=5

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen2.5-14b-instruct-1m-abliterated
LM_STUDIO_TIMEOUT_SECONDS=90

# local = LM Studio jako mozg; cloud/venice = Venice jako mozg.
LLM_PRIMARY=local
# Opcjonalny dostawca chmurowy zgodny z OpenAI API.
# Venice: https://api.venice.ai/api/v1.
CLOUD_LLM_ENABLED=false
CLOUD_LLM_BASE_URL=https://api.venice.ai/api/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=venice-uncensored-1-2

# Szybkie wyszukiwanie informacji w internecie.
WEB_SEARCH_ENABLED=true
# venice (wymaga CLOUD_LLM_API_KEY), gemini (wymaga WEB_SEARCH_API_KEY),
# brave (wymaga WEB_SEARCH_API_KEY) lub duckduckgo (bez klucza).
WEB_SEARCH_PROVIDER=duckduckgo
# Fallback gdy provider glowny ma blad/limit.
WEB_SEARCH_FALLBACK_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_GEMINI_MODEL=gemini-3.6-flash
WEB_SEARCH_TIMEOUT_SECONDS=6
WEB_SEARCH_MAX_RESULTS=5

LOCAL_EMBEDDINGS_ENABLED=true
LOCAL_EMBEDDINGS_BASE_URL=
LOCAL_EMBEDDINGS_API_KEY=
LOCAL_EMBEDDINGS_MODEL=text-embedding-nomic-embed-text-v2-moe
LOCAL_EMBEDDINGS_TIMEOUT_SECONDS=30
VECTOR_MEMORY_CONTEXT_LIMIT=8
QDRANT_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voiceloop_memory
QDRANT_TIMEOUT_SECONDS=10
QDRANT_DUAL_WRITE=true
# Lokalny Qwen analizuje także podczas aktywnej pracy; nie czeka na bezczynnosc.
BEHAVIOR_DIGEST_ENABLED=true
BEHAVIOR_DIGEST_MODEL=qwen2.5-14b-instruct-1m-abliterated
BEHAVIOR_DIGEST_TIMEOUT_SECONDS=240
BEHAVIOR_DIGEST_POLL_SECONDS=60
BEHAVIOR_DIGEST_RECENT_MINUTES=30
BEHAVIOR_DIGEST_MAX_CONTEXTS=24

# Lokalny, nieprzefiltrowany kontekst Screenpipe.
# Jeśli włączysz API authentication w Screenpipe, wpisz token tylko lokalnie.
SCREENPIPE_ENABLED=true
SCREENPIPE_BASE_URL=http://127.0.0.1:3030
SCREENPIPE_API_TOKEN=
SCREENPIPE_TIMEOUT_SECONDS=5
SCREENPIPE_RECENT_WINDOW_SECONDS=90
SCREENPIPE_HISTORY_LIMIT=20
SCREENPIPE_LOOKBACK_DAYS=14
# Globalna transkrypcja Screenpipe pozostaje wyłączona. Ten worker wysyła do
# Deepgram tylko zakończone spotkania; YouTube jest blokowany bez wyjątków.
SCREENPIPE_DEEPGRAM_ENABLED=true
SCREENPIPE_DEEPGRAM_POLL_SECONDS=30
SCREENPIPE_DEEPGRAM_MEETING_GRACE_SECONDS=90
SCREENPIPE_DEEPGRAM_MAX_FILE_MB=100
SCREENPIPE_DEEPGRAM_BLOCKED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be
SCREENPIPE_DEEPGRAM_CALL_HOSTS=meet.google.com,teams.microsoft.com,zoom.us,discord.com,webex.com
SCREENPIPE_DEEPGRAM_CALL_APPS=zoom,teams,discord,webex,skype,slack
SCREENPIPE_VECTOR_MEMORY_ENABLED=true
SCREENPIPE_VECTOR_POLL_SECONDS=120
SCREENPIPE_VECTOR_RECENT_MINUTES=60

VOICEATTACK_EXE=C:/Program Files/VoiceAttack/VoiceAttack.exe
VOICEATTACK_REGISTRATION_KEY=
# Opcjonalny Azure TTS (glos premium). Gdy niedostepny, fallback to Windows TTS.
AZURE_TTS_ENABLED=false
AZURE_TTS_KEY=
AZURE_TTS_REGION=
AZURE_TTS_VOICE=pl-PL-ZofiaNeural
AZURE_TTS_TIMEOUT_SECONDS=20
UIVISION_HOME=
UIVISION_TIMEOUT_SECONDS=60
COMMAND_DEDUPE_SECONDS=2
COMMAND_QUEUE_LIMIT=10
