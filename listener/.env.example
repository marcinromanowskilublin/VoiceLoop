# Skopiuj jako .env i uzupełnij lokalnie. Nie commituj pliku .env.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pl
# Live: "latest" obecnie wskazuje diarizer v1. Nie ustawiaj równocześnie diarize=true.
DEEPGRAM_DIARIZATION_ENABLED=true
DEEPGRAM_DIARIZATION_MODEL=latest
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1200
SAMPLE_RATE=16000
AUTO_START_LISTENING=false
AUTO_START_CONVERSATION=false
CONVERSATION_GREETING=Cześć. Możemy porozmawiać albo możesz od razu wydać polecenie. Możesz też zapytać, co potrafię. W czym mogę pomóc?
CONVERSATION_COOLDOWN_MS=100
# Po tylu ms jej mowy mic może ją przerwać (barge-in). 3000 = 3 s, 5000 = 5 s.
CONVERSATION_BARGE_IN_AFTER_MS=3000
# Nowa ścieżka utrzymuje mikrofon/WS gotowy i zachowuje legacy po ustawieniu false.
CONVERSATION_STREAM_REUSE_ENABLED=true
CONVERSATION_HYBRID_BARGE_IN_ENABLED=true
CONVERSATION_HYBRID_BARGE_IN_GRACE_MS=350
CONVERSATION_BARGE_IN_STABILITY_MS=150
# auto, headphones albo speakers
CONVERSATION_BARGE_IN_PROFILE=auto
# Po 30 s bez odpowiedzi kolejna wypowiedź wymaga "Asystencie..." lub "Venice...".
# Bezpośrednio po odpowiedzi nadal działa naturalny dialog bez wake worda.
CONVERSATION_DIRECT_ADDRESS_AFTER_SECONDS=30
# Gdy Deepgram wykryje co najmniej 2 mówców, odpowiedź wymaga zwrotu
# "Asystencie..." / "Venice...". Diaryzacja rozróżnia osoby, ale nie zna właściciela.
CONVERSATION_IGNORE_MULTI_SPEAKER=true
STT_MIN_ACTION_CONFIDENCE=0.75
# Opcjonalnie: indeks lub nazwa urządzenia zwrócona przez sounddevice.
# MICROPHONE_DEVICE=Microphone Array
VOICELOOP_TOKEN=

VOICELOOP_HOST=127.0.0.1
VOICELOOP_PORT=8765
VOICELOOP_LOG_LEVEL=INFO
VOICELOOP_DATA_DIR=../data

N8N_ENABLED=false
N8N_BASE_URL=http://127.0.0.1:5678
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/voice-command-v1
N8N_TOKEN=
N8N_TIMEOUT_SECONDS=5

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen2.5-14b-instruct-1m-abliterated
LM_STUDIO_TIMEOUT_SECONDS=90

# local = LM Studio; gemini = Gemini dialog; cloud/venice = Venice.
LLM_PRIMARY=local
# auto = pełny kontekst lokalnie, bez prywatnego kontekstu w chmurze;
# off = bez kontekstu; session = tylko dialog; full = dialog, pamięć i jawny ekran.
CONVERSATION_CONTEXT_POLICY=auto
# Opcjonalny dostawca chmurowy zgodny z OpenAI API.
# Venice: https://api.venice.ai/api/v1.
CLOUD_LLM_ENABLED=false
CLOUD_LLM_BASE_URL=https://api.venice.ai/api/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=venice-uncensored-1-2

# Gemini jako mozg rozmowy (OpenAI-compatible endpoint).
# Przy LLM_PRIMARY=gemini lokalny Qwen z LM Studio zostaje fallbackiem.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=90

# Szybkie wyszukiwanie informacji w internecie.
WEB_SEARCH_ENABLED=true
# venice (wymaga CLOUD_LLM_API_KEY), gemini (wymaga WEB_SEARCH_API_KEY lub GEMINI_API_KEY),
# gemini, venice, brave (wymaga klucza) albo duckduckgo (bez klucza).
WEB_SEARCH_PROVIDER=duckduckgo
# Fallback gdy provider glowny ma blad/limit.
WEB_SEARCH_FALLBACK_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_GEMINI_MODEL=gemini-3.6-flash
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_RESULTS=5
KNOWLEDGE_TOOLS_ENABLED=true
KNOWLEDGE_TOOLS_MAX_RESULTS=5
KNOWLEDGE_TOOLS_TIMEOUT_SECONDS=15
KNOWLEDGE_TOOLS_CACHE_TTL_SECONDS=300

LOCAL_EMBEDDINGS_ENABLED=true
LOCAL_EMBEDDINGS_BASE_URL=
LOCAL_EMBEDDINGS_API_KEY=
LOCAL_EMBEDDINGS_MODEL=text-embedding-nomic-embed-text-v2-moe
LOCAL_EMBEDDINGS_TIMEOUT_SECONDS=30
VECTOR_MEMORY_CONTEXT_LIMIT=8
# Zero celowo. Zmierzone dno nomic-v2-moe na realnych danych to 0.441, więc
# jakikolwiek próg poniżej tej wartości nie odrzuca niczego. RRF rankinguje na
# rangach i bramki nie potrzebuje. Szczegóły w vectorscope/README.md.
VECTOR_MEMORY_MIN_SCORE=0.0
VECTOR_MEMORY_ADAPTIVE_QUERY_WEIGHTS=true
VECTOR_MEMORY_WEIGHT_SEMANTIC=0.40
VECTOR_MEMORY_WEIGHT_TOPIC=0.20
VECTOR_MEMORY_WEIGHT_INTENT=0.15
VECTOR_MEMORY_WEIGHT_DECISION=0.15
VECTOR_MEMORY_WEIGHT_PERSON_CONTEXT=0.10
VECTOR_MEMORY_RRF_K=60
# Strażnik progów. Raz na dobę mierzy rozkłady na realnej kolekcji i orzeka,
# czy każdy próg jest martwy, nieosiągalny czy działa. Werdykt widać
# w /api/v1/health. Tylko odczyt: scroll i query_points.
THRESHOLD_GUARD_ENABLED=true
THRESHOLD_GUARD_INTERVAL_SECONDS=86400
THRESHOLD_GUARD_SAMPLE=40
CAPABILITY_EMBEDDINGS_ENABLED=true
CAPABILITY_MATCH_LIMIT=5
# Próg tylko dla kandydatów diagnostycznych; embedding nie wykonuje akcji.
CAPABILITY_MATCH_MIN_SCORE=0.20
# Routing V2 jest domyślnie tylko obserwowany. Wykonanie wymaga jawnego
# SHADOW_MODE=false oraz kompletnego, zgodnego z katalogiem raportu quality gate.
ROUTING_V2_ENABLED=true
ROUTING_V2_SHADOW_MODE=true
ROUTING_V2_EXECUTE=false
# Gdy execute=true, canary to jawna allowlista akcji LOW bez potwierdzenia.
ROUTING_V2_CANARY_ENABLED=true
ROUTING_V2_CANARY_ACTION_IDS=describe_active_window,describe_recent_activity,describe_text_target,recall,open_url,open_browser,open_folder,open_app
ROUTING_V2_CANDIDATE_LIMIT=10
ROUTING_V2_EXECUTE_MIN_SCORE=0.50
ROUTING_V2_EXECUTE_MIN_MARGIN=0.10
ROUTING_V2_MAX_SUBTASKS=12
ROUTING_V2_SHADOW_TIMEOUT_SECONDS=5
ROUTING_V2_QUALITY_GATE_FILE=corpus/eval/routing-v2-metrics.json
# Kalibracja confidence Routing V2:
# off = całkowicie wyłączona, report_only = tylko raport/pomiary bez wpływu na decyzję.
ROUTING_V2_CALIBRATION_MODE=off
ROUTING_V2_CALIBRATION_ARTIFACT_FILE=corpus/eval/routing-calibration-artifact-v1.json
ROUTING_V2_CALIBRATION_STORE_FILE=corpus/routing_calibration/observations-v1.db
ROUTING_V2_CALIBRATION_QUEUE_LIMIT=4096
QDRANT_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voiceloop_memory
QDRANT_CAPABILITY_COLLECTION=voiceloop_capabilities_v1
# Opcjonalne kolekcje migracyjne. Puste oznaczają brak dual-read/shadow reindeksu.
QDRANT_MEMORY_NEXT_COLLECTION=
QDRANT_CAPABILITY_NEXT_COLLECTION=
QDRANT_TIMEOUT_SECONDS=10
QDRANT_DUAL_WRITE=true
VECTOR_MEMORY_TTL_DAYS=14
# Retencja jest domyślnie tylko raportowana; trwałe kasowanie wymaga jawnego true.
VECTOR_MEMORY_PRUNE_ENABLED=false
VECTOR_MEMORY_PRUNE_INTERVAL_SECONDS=86400
# Lokalny Qwen analizuje także podczas aktywnej pracy; nie czeka na bezczynnosc.
BEHAVIOR_DIGEST_ENABLED=true
BEHAVIOR_DIGEST_MODEL=qwen2.5-14b-instruct-1m-abliterated
BEHAVIOR_DIGEST_TIMEOUT_SECONDS=240
BEHAVIOR_DIGEST_POLL_SECONDS=300
BEHAVIOR_DIGEST_RECENT_MINUTES=10
BEHAVIOR_DIGEST_MAX_CONTEXTS=24
BEHAVIOR_DIGEST_MIN_CONFIDENCE=0.65
# Lokalny korpus pozostaje w data/corpus i nigdy nie korzysta z chmury.
CORPUS_ENABLED=true
CORPUS_STYLE_PROFILE_ENABLED=false
CORPUS_STYLE_PROFILE_FILE=style/profile-v1.json
CORPUS_ROUTING_MARGIN_THRESHOLD=0.05

# Lokalny, nieprzefiltrowany kontekst Screenpipe.
# Jeśli włączysz API authentication w Screenpipe, wpisz token tylko lokalnie.
SCREENPIPE_ENABLED=true
SCREENPIPE_BASE_URL=http://127.0.0.1:3030
SCREENPIPE_API_TOKEN=
SCREENPIPE_TIMEOUT_SECONDS=5
SCREENPIPE_RECENT_WINDOW_SECONDS=90
SCREENPIPE_HISTORY_LIMIT=20
SCREENPIPE_LOOKBACK_DAYS=14
# Globalna transkrypcja Screenpipe pozostaje wyłączona. Ten worker wysyła do
# Deepgram tylko zakończone spotkania; YouTube jest blokowany bez wyjątków.
SCREENPIPE_DEEPGRAM_ENABLED=true
SCREENPIPE_DEEPGRAM_POLL_SECONDS=30
SCREENPIPE_DEEPGRAM_MEETING_GRACE_SECONDS=90
SCREENPIPE_DEEPGRAM_MAX_FILE_MB=100
SCREENPIPE_DEEPGRAM_BLOCKED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be
SCREENPIPE_DEEPGRAM_CALL_HOSTS=meet.google.com,teams.microsoft.com,zoom.us,discord.com,webex.com
SCREENPIPE_DEEPGRAM_CALL_APPS=zoom,teams,discord,webex,skype,slack
# Jawny tryb spotkania omija detekcję aplikacji: zapisuje pełne kanały
# input/output lokalnie i pokazuje diarization z Deepgram w panelu.
MEETING_RECORDING_POLL_SECONDS=5
MEETING_RECORDING_FINALIZE_SECONDS=25
MEETING_RECORDING_ARCHIVE_AUDIO=true
MEETING_RECORDING_AUDIO_CHUNK_SECONDS=15
MEETING_RECORDING_OUTPUT_SAMPLE_RATE=48000
SCREENPIPE_VECTOR_MEMORY_ENABLED=false
SCREENPIPE_VECTOR_POLL_SECONDS=300
SCREENPIPE_VECTOR_RECENT_MINUTES=10

VOICEATTACK_EXE=C:/Program Files/VoiceAttack/VoiceAttack.exe
VOICEATTACK_REGISTRATION_KEY=
# Eksperymentalny prototyp Hume. Domyślnie wyłączony i nieobjęty demo portfolio.
# Po jawnym włączeniu wysyła fragmenty audio spotkań do chmurowego Hume EVI.
# Nie deklarujemy jeszcze zweryfikowanego działania end-to-end.
HUME_API_KEY=
HUME_EMOTION_ANALYSIS_ENABLED=false
HUME_EMOTION_ENDPOINT=wss://api.hume.ai/v0/evi/chat
HUME_EMOTION_TIMEOUT_SECONDS=30
HUME_EMOTION_TOP_N=3
HUME_EMOTION_MIN_SCORE=0.05
# Opcjonalny Azure TTS (glos premium). Gdy niedostepny, fallback to Windows TTS.
AZURE_TTS_ENABLED=false
AZURE_TTS_KEY=
AZURE_TTS_REGION=
AZURE_TTS_VOICE=pl-PL-ZofiaNeural
AZURE_TTS_TIMEOUT_SECONDS=20
TTS_RATE_PERCENT=-20
TTS_PITCH_PERCENT=-5
UIVISION_HOME=
UIVISION_TIMEOUT_SECONDS=60
COMMAND_DEDUPE_SECONDS=2
COMMAND_QUEUE_LIMIT=10
